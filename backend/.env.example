# Строка подключения к PostgreSQL. Локально можно не задавать — используется SQLite (app.db).
DATABASE_URL=

# Любая случайная строка для подписи JWT-токенов.
SECRET_KEY=

# Любая случайная строка для защиты /admin/* эндпоинтов (передаётся как ?admin_key=...).
ADMIN_KEY=

# OAuth-токен Яндекс.Диска с правом "Запись в любом месте на Диске". Получить на oauth.yandex.ru.
# Если не задан — синхронизация с Яндекс.Диском и загрузка фото отзывов просто не выполняются.
YANDEX_DISK_TOKEN=
